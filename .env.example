# Forward Focus Elevation — Environment Configuration (Template)
# Duplicate this file to .env.local and fill in the values below.

# ── Frontend (Vite) ──────────────────────────────────────────
# NO SECRETS HERE! All keys must start with VITE_ to be exposed to the client.
# Required for Vercel deployment:
# - VITE_SUPABASE_URL
# - VITE_SUPABASE_PUBLISHABLE_KEY
# - VITE_META_PIXEL_ID
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
 VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_KEY"
 VITE_SUPABASE_PROJECT_ID="YOUR_PROJECT_REF"
 VITE_META_PIXEL_ID="YOUR_PIXEL_ID"

# ── Project Reference ─────────────────────────────────────────
# Example: peckmhkxhgkgopmjthmp (forwardfocus-elevation)
PROJECT_ID=YOUR_PROJECT_REF